# Required: bearer token clients send as `Authorization: Bearer <token>`. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional (defaults shown)
PORT=3000
DATA_DIR=./data
SOURCE_TIMEOUT_MS=8000
REQUEST_BUDGET_MS=20000
# How long a tool call may wait for queued Open Food Facts lookups (they are paced to the API quotas)
OFF_MAX_WAIT_MS=120000
# Keep a local copy of Open Food Facts (about 4.5 GB in DATA_DIR, twice that while rebuilt) for barcode and name lookups
OFF_LOCAL_DB=false
LOG_LEVEL=info
# Comma-separated source ids to disable, e.g. "lavieclaire,kazidomi"
DISABLED_SOURCES=
