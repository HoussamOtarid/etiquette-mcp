{
  "name": "etiquette-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server that looks up a food product across several French grocery sources and returns the best-supported nutrition label with agreement indicators.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoussamOtarid/etiquette-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "1.2.0",
    "fastest-levenshtein": "1.0.16",
    "snowball-stemmers": "0.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
